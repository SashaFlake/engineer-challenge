# Скопируй в terraform.tfvars и заполни своими значениями
# НИКОГДА не коммить terraform.tfvars в git!

# ─── SSH / VM ─────────────────────────────────────────────────────────────────
master_ip            = "1.2.3.4"           # публичный IP мастера
worker_ip            = "10.0.1.4"          # приватный IP воркера (нет публичного)
master_private_ip    = "10.0.1.3"          # приватный IP мастера (для k3s agent)
ssh_user             = "user1"
ssh_private_key_path = "~/.ssh/cloudruce"

# ─── App ──────────────────────────────────────────────────────────────────────
app_image_tag        = "latest"
app_image_repository = "ghcr.io/sashaflake/auth-service"
cors_allowed_hosts   = "http://1.2.3.4:30080"  # или https://yourdomain.com
namespace            = "auth"

# ─── Secrets — лучше передавать через env ─────────────────────────────────────
# export TF_VAR_jwt_secret=$(openssl rand -base64 32)
# export TF_VAR_grafana_admin_password="your-password"
# export TF_VAR_letsencrypt_email="your@email.com"
#
# Если всё же указываешь здесь — убедись что terraform.tfvars в .gitignore
jwt_secret             = "change-me"
grafana_admin_password = "change-me"
letsencrypt_email      = "your@email.com"

# ─── Observability ────────────────────────────────────────────────────────────
# Если нет домена — передай IP адрес, NodePort 32000 включится автоматически.
# Если есть домен — ingress + TLS через cert-manager подключатся сами.
grafana_hostname = "1.2.3.4"
app_hostname     = "auth.yourdomain.com"
