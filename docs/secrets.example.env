# GitHub Environment: prod
# Settings → Environments → prod → Environment secrets
#
# Не коммитить реальные значения!

# Подпись JWT токенов.
# Генерация: openssl rand -base64 32
JWT_SECRET_PROD=<your-random-secret>

# Разрешённые для CORS хосты.
# Пример: http://<PUBLIC_IP>:30081
# Несколько хостов через запятую: http://host1:30081,http://host2:3000
CORS_ALLOWED_HOSTS=http://<PUBLIC_IP>:30081

# kubeconfig для подключения к k3s.
# См. шаблон docs/kubeconfig.example.yaml
KUBECONFIG_PROD=<paste-full-kubeconfig-yaml-here>
